<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:background="@color/primary">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:src="@drawable/back"
            android:contentDescription="返回"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/health_records"
            android:textSize="@dimen/font_size_lg"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/edit_button"
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:src="@drawable/more"
            android:contentDescription="编辑"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="基本信息"
                    android:textSize="@dimen/font_size_lg"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="姓名"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年龄"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/age_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="性别"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/gender_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="血型"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/blood_type_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="过敏史"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/allergy_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="健康档案"
                android:textSize="@dimen/font_size_lg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/xueya"
                        android:layout_marginEnd="@dimen/spacing_md"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="血压"
                            android:textSize="@dimen/font_size_md"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/blood_pressure_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未测量"
                            android:textSize="@dimen/font_size_sm"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mmHg"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_hint"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/xinlv"
                        android:layout_marginEnd="@dimen/spacing_md"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="心率"
                            android:textSize="@dimen/font_size_md"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/heart_rate_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未测量"
                            android:textSize="@dimen/font_size_sm"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次/分"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_hint"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/xuetang"
                        android:layout_marginEnd="@dimen/spacing_md"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="血糖"
                            android:textSize="@dimen/font_size_md"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/blood_sugar_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未测量"
                            android:textSize="@dimen/font_size_sm"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mmol/L"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_hint"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/tiwen"
                        android:layout_marginEnd="@dimen/spacing_md"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="体温"
                            android:textSize="@dimen/font_size_md"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/temperature_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未测量"
                            android:textSize="@dimen/font_size_sm"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="°C"
                        android:textSize="@dimen/font_size_sm"
                        android:textColor="@color/text_hint"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="病史记录"
                android:textSize="@dimen/font_size_lg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/medical_history_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无病史记录"
                    android:textSize="@dimen/font_size_md"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>