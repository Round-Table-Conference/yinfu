<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="@dimen/font_size_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_subtitle"
            android:textSize="@dimen/font_size_md"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_xl"/>

        <LinearLayout
            android:id="@+id/emergency_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/feature_card_background"
            android:padding="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_md"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/icon_size_lg"
                android:layout_height="@dimen/icon_size_lg"
                android:src="@drawable/emergency_sos"
                android:contentDescription="@string/emergency_sos"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emergency_sos"
                android:textSize="@dimen/font_size_lg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/spacing_md"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/features_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/health_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_background"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/health"
                        android:contentDescription="@string/health_management"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_management"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_sm"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/psychology_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_background"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/social_chat"
                        android:contentDescription="@string/psychology_support"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/psychology_support"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_sm"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/payment_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_background"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/pending_alt"
                        android:contentDescription="@string/payment_help"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_help"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_sm"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/classroom_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_background"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/resource"
                        android:contentDescription="@string/digital_classroom"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/digital_classroom"
                        android:textSize="@dimen/font_size_md"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_sm"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
